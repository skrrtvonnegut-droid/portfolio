{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skrrtvonnegut-droid.github.io/portfolio/schemas/portfolio-artifact.schema.json",
  "title": "Portfolio Artifact",
  "description": "Public metadata contract for a sanitized professional portfolio artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "kind",
    "title",
    "summary",
    "status",
    "classification",
    "provenance",
    "authorship",
    "domains",
    "skills",
    "rights",
    "review",
    "featured"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^portfolio\\.(case-study|template|project-card|technical-pattern|learning-note|architecture)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:[/-][a-z0-9]+)*/$"
    },
    "kind": {
      "enum": [
        "case-study",
        "template",
        "project-card",
        "technical-pattern",
        "learning-note",
        "architecture"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "status": {
      "enum": [
        "published",
        "archived"
      ]
    },
    "classification": {
      "const": "professional-portfolio"
    },
    "provenance": {
      "enum": [
        "original",
        "ai-assisted-original",
        "adapted",
        "external-reference"
      ]
    },
    "authorship": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "security",
          "endpoint",
          "automation",
          "microsoft-365",
          "ai-llm",
          "operations",
          "documentation",
          "governance",
          "career"
        ]
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishable",
        "attribution",
        "source_url"
      ],
      "properties": {
        "publishable": {
          "const": true
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_reviewed",
        "review_due"
      ],
      "properties": {
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "review_due": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "featured": {
      "type": "boolean"
    }
  }
}
