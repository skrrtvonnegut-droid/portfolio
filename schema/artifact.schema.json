{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skrrtvonnegut-droid.github.io/portfolio/schema/artifact.schema.json",
  "title": "Professional Portfolio Artifact",
  "description": "Merged public contract for artifact content metadata and governance metadata.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "artifact_type",
    "domains",
    "status",
    "classification",
    "source_disclosure",
    "skills",
    "created",
    "updated",
    "provenance",
    "authorship",
    "rights",
    "review",
    "featured"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^portfolio\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^/artifacts/[a-z0-9]+(?:[/-][a-z0-9]+)*/$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 240
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "architecture",
        "case-study",
        "code-project",
        "knowledge-article",
        "learning-note",
        "project-card",
        "runbook",
        "sop",
        "technical-pattern",
        "template"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "review-due",
        "superseded",
        "archived"
      ]
    },
    "classification": {
      "const": "professional-portfolio"
    },
    "source_disclosure": {
      "type": "string",
      "minLength": 40,
      "maxLength": 300
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "provenance": {
      "enum": [
        "original",
        "ai-assisted-original",
        "adapted",
        "external-reference"
      ]
    },
    "authorship": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishable",
        "attribution",
        "source_url"
      ],
      "properties": {
        "publishable": {
          "const": true
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_reviewed",
        "review_due"
      ],
      "properties": {
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "review_due": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "featured": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
